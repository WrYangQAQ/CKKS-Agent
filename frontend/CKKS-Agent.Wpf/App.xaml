<Application
    x:Class="CKKS_Agent.Wpf.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CKKS_Agent.Wpf.Controls"
    xmlns:converters="clr-namespace:CKKS_Agent.Wpf.Converters"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:StringEqualsConverter x:Key="StringEquals"/>
        <converters:FieldIconConverter x:Key="IconByMode"/>

        <!-- 输入框左侧图标（按 20x20 画布绘制，线条样式） -->
        <PathGeometry
            x:Key="IconUser"
            Figures="M6.8,6.8 A3.2,3.2 0 1 1 13.2,6.8 A3.2,3.2 0 1 1 6.8,6.8 Z M3.8,17 C3.8,13.6 6.6,11 10,11 C13.4,11 16.2,13.6 16.2,17"/>
        <PathGeometry
            x:Key="IconPhone"
            Figures="M6.8,2.6 H13.2 A1.8,1.8 0 0 1 15,4.4 V15.6 A1.8,1.8 0 0 1 13.2,17.4 H6.8 A1.8,1.8 0 0 1 5,15.6 V4.4 A1.8,1.8 0 0 1 6.8,2.6 Z M8.8,14.9 H11.2"/>
        <PathGeometry
            x:Key="IconMail"
            Figures="M3.4,5.2 H16.6 A1.3,1.3 0 0 1 17.9,6.5 V13.5 A1.3,1.3 0 0 1 16.6,14.8 H3.4 A1.3,1.3 0 0 1 2.1,13.5 V6.5 A1.3,1.3 0 0 1 3.4,5.2 Z M2.5,6 L10,11.1 L17.5,6"/>
        <PathGeometry
            x:Key="IconLock"
            Figures="M5.4,9.2 H14.6 A1.3,1.3 0 0 1 15.9,10.5 V15.7 A1.3,1.3 0 0 1 14.6,17 H5.4 A1.3,1.3 0 0 1 4.1,15.7 V10.5 A1.3,1.3 0 0 1 5.4,9.2 Z M7.2,9.2 V6.7 A2.8,2.8 0 0 1 12.8,6.7 V9.2"/>
        <PathGeometry
            x:Key="IconShield"
            Figures="M10,2.4 L16.1,4.7 V9.5 C16.1,13.4 13.6,16.3 10,17.7 C6.4,16.3 3.9,13.4 3.9,9.5 V4.7 Z M7.3,9.7 L9.2,11.6 L12.8,8"/>

        <!-- 登录方式 / 验证方式：横排文字单选，选中为黑色，未选中为灰色，均带下划线 -->
        <Style x:Key="AuthOption" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C3C3C3"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid VerticalAlignment="Center">
                            <TextBlock
                                x:Name="OptionText"
                                Text="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                Margin="0,0,0,3"
                                VerticalAlignment="Center"/>
                            <Rectangle
                                x:Name="OptionUnderline"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Visibility="Hidden"
                                Fill="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptionText" Property="Foreground" Value="#111111"/>
                                <Setter TargetName="OptionUnderline" Property="Fill" Value="#111111"/>
                                <Setter TargetName="OptionUnderline" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AuthOptionSeparator" TargetType="TextBlock">
            <Setter Property="Text" Value="/"/>
            <Setter Property="Foreground" Value="#C3C3C3"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <!-- 密码框右侧的“眼睛”按钮：灰色为隐藏，黑色为明文显示 -->
        <Style x:Key="EyeToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Path
                                x:Name="EyeOutline"
                                Data="M1,8 C4.2,3.2 11.8,3.2 15,8 C11.8,12.8 4.2,12.8 1,8 Z"
                                Width="17"
                                Height="17"
                                Stretch="Uniform"
                                Stroke="#8A8F98"
                                StrokeThickness="1.2"
                                Fill="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                            <Ellipse
                                x:Name="EyePupil"
                                Width="4.6"
                                Height="4.6"
                                Stroke="#8A8F98"
                                StrokeThickness="1.2"
                                Fill="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="EyeOutline" Property="Stroke" Value="#55595F"/>
                                <Setter TargetName="EyePupil" Property="Stroke" Value="#55595F"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="EyeOutline" Property="Stroke" Value="#111111"/>
                                <Setter TargetName="EyePupil" Property="Stroke" Value="#111111"/>
                                <Setter TargetName="EyePupil" Property="Fill" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字输入框：空且未聚焦时标签在框内当占位符，聚焦或有内容后上浮到上边框 -->
        <Style x:Key="FloatingField" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="60,0,14,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border
                                x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#CED1D5"
                                BorderThickness="1"/>
                            <Path
                                Data="{Binding Path=(controls:FieldIcon.Geometry), RelativeSource={RelativeSource TemplatedParent}}"
                                Width="18"
                                Height="18"
                                Stretch="Uniform"
                                Stroke="#8A8F98"
                                StrokeThickness="1.2"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Fill="Transparent"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                IsHitTestVisible="False"/>
                            <Rectangle
                                Width="1"
                                Height="18"
                                Fill="#DCDDE0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="44,0,0,0"
                                IsHitTestVisible="False"/>
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden"/>
                            <Border
                                x:Name="LabelChip"
                                Background="{TemplateBinding Background}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="56,-8,0,0"
                                Padding="4,0"
                                IsHitTestVisible="False">
                                <TextBlock
                                    x:Name="LabelText"
                                    Text="{Binding Path=(controls:FloatingLabel.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                    FontSize="12"
                                    Foreground="#8A8F98"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                    <Condition Property="IsKeyboardFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="LabelChip" Property="VerticalAlignment" Value="Center"/>
                                <Setter TargetName="LabelChip" Property="Margin" Value="56,0,0,0"/>
                                <Setter TargetName="LabelText" Property="FontSize" Value="16"/>
                                <Setter TargetName="LabelText" Property="Foreground" Value="#A0A5AC"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#111111"/>
                                <Setter TargetName="Frame" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="LabelText" Property="Foreground" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 密码输入框：浮动标签 + 右侧明文切换 -->
        <Style TargetType="{x:Type controls:PasswordField}">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:PasswordField}">
                        <Grid>
                            <Border
                                x:Name="Frame"
                                Background="White"
                                BorderBrush="#CED1D5"
                                BorderThickness="1"/>
                            <Path
                                Data="{Binding Path=(controls:FieldIcon.Geometry), RelativeSource={RelativeSource TemplatedParent}}"
                                Width="18"
                                Height="18"
                                Stretch="Uniform"
                                Stroke="#8A8F98"
                                StrokeThickness="1.2"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                Fill="Transparent"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0"
                                IsHitTestVisible="False"/>
                            <Rectangle
                                Width="1"
                                Height="18"
                                Fill="#DCDDE0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="44,0,0,0"
                                IsHitTestVisible="False"/>
                            <PasswordBox
                                x:Name="PART_MaskedBox"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="60,0,44,0"
                                FontSize="16"
                                VerticalContentAlignment="Center"/>
                            <TextBox
                                x:Name="PART_PlainBox"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="60,0,44,0"
                                FontSize="16"
                                VerticalContentAlignment="Center"
                                Visibility="Collapsed"/>
                            <Border
                                x:Name="LabelChip"
                                Background="White"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="56,-8,0,0"
                                Padding="4,0"
                                IsHitTestVisible="False">
                                <TextBlock
                                    x:Name="LabelText"
                                    Text="{TemplateBinding Label}"
                                    FontSize="12"
                                    Foreground="#8A8F98"/>
                            </Border>
                            <ToggleButton
                                x:Name="PART_RevealButton"
                                Style="{StaticResource EyeToggle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="HasText" Value="False"/>
                                    <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="LabelChip" Property="VerticalAlignment" Value="Center"/>
                                <Setter TargetName="LabelChip" Property="Margin" Value="56,0,0,0"/>
                                <Setter TargetName="LabelText" Property="FontSize" Value="16"/>
                                <Setter TargetName="LabelText" Property="Foreground" Value="#A0A5AC"/>
                            </MultiTrigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#111111"/>
                                <Setter TargetName="Frame" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="LabelText" Property="Foreground" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="Height" Value="68"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#1A1A1A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#8A8F98"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Outline" TargetType="Button">
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#222"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="Foreground" Value="#575C64"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
