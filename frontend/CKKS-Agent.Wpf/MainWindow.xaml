<Window
    x:Class="CKKS_Agent.Wpf.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:CKKS_Agent.Wpf.Controls"
    Title="CKKS System"
    Height="810"
    Width="1296"
    MinHeight="720"
    MinWidth="1080"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    Background="#FCFCFB"
    FontFamily="Microsoft YaHei UI">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="44"
            ResizeBorderThickness="6"
            GlassFrameThickness="0"
            CornerRadius="0"
            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏：整条可拖动，右侧为窗口按钮 -->
        <Border BorderBrush="#E1E3E6" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0">
                    <Image
                        Source="/wwwroot/logo/logo.png"
                        Width="24"
                        Height="24"
                        Margin="0,0,13,0"
                        VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="CKKS System" FontSize="18"/>
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch">
                    <Button
                        Style="{StaticResource CaptionButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnMinimizeClick"
                        ToolTip="最小化">
                        <Rectangle
                            Width="10"
                            Height="1"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button
                        Style="{StaticResource CaptionButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnMaximizeClick"
                        ToolTip="最大化 / 还原">
                        <Grid Width="10" Height="10">
                            <Path
                                Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                StrokeThickness="1">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Value="Maximized">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path
                                Data="M2.5,0.5 H9.5 V7.5 H7.5 M7.5,2.5 V9.5 H0.5 V2.5 Z"
                                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                StrokeThickness="1">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger
                                                Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Value="Maximized">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                    <Button
                        Style="{StaticResource CaptionCloseButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseClick"
                        ToolTip="关闭">
                        <Path
                            Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5"
                            Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                            StrokeThickness="1"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 未登录页面：左侧装饰背景 + 右侧登录/注册表单 -->
        <Grid Grid.Row="1" Visibility="{Binding IsAnonymous,Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46*"/>
                <ColumnDefinition Width="54*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#E1E3E6" BorderThickness="0,0,1,0">
                <Grid>
                    <!-- 左侧装饰仅在该面板内绘制，避免元素越过分栏线 -->
                    <Canvas Opacity=".65" ClipToBounds="True">
                        <Ellipse Canvas.Left="165" Canvas.Top="135" Width="260" Height="260" Stroke="#B9BEC5"/>
                        <Ellipse Canvas.Left="202" Canvas.Top="172" Width="186" Height="186" Stroke="#B9BEC5"/>
                        <Ellipse Canvas.Left="246" Canvas.Top="216" Width="98" Height="98" Stroke="#B9BEC5"/>
                        <Line X1="125" Y1="265" X2="425" Y2="265" Stroke="#838991"/>
                        <Line X1="286" Y1="125" X2="286" Y2="405" Stroke="#838991"/>
                        <Ellipse Canvas.Left="281" Canvas.Top="260" Width="10" Height="10" Fill="#555B63"/>
                        <!-- 斜置等边三角形：与辅助线保持相同的低对比度灰色 -->
                        <Canvas Canvas.Left="475" Canvas.Top="475" Width="100" Height="100">
                            <Polygon
                                Points="10,56 50,32 10,8"
                                Stroke="#A7ADB5"
                                StrokeThickness="1"
                                Fill="Transparent">
                                <Polygon.RenderTransform>
                                    <RotateTransform Angle="-18" CenterX="30" CenterY="32"/>
                                </Polygon.RenderTransform>
                            </Polygon>
                            <Polygon
                                Points="36,82 76,58 36,34"
                                Stroke="#A7ADB5"
                                StrokeThickness="1"
                                Fill="Transparent"
                                Opacity="0.58">
                                <Polygon.RenderTransform>
                                    <RotateTransform Angle="-18" CenterX="56" CenterY="58"/>
                                </Polygon.RenderTransform>
                            </Polygon>
                        </Canvas>
                        <Line X1="140" Y1="700" X2="410" Y2="700" Stroke="#A7ADB5"/>
                        <Ellipse Canvas.Left="290" Canvas.Top="687" Width="26" Height="26" Stroke="#A7ADB5"/>
                    </Canvas>
                    <StackPanel VerticalAlignment="Center" Margin="100,280,60,0">
                        <TextBlock Text="CKKS System" FontSize="56" FontWeight="Light"/>
                        <TextBlock
                            Text="参数寻优 · Agent 自动规划 · 安全计算"
                            Foreground="#898E97"
                            FontSize="15"
                            Margin="4,16,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <StackPanel Width="420" VerticalAlignment="Center">
                    <TextBlock
                        Text="{Binding AuthTitle}"
                        FontSize="54"
                        FontWeight="Light"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,42"/>

                    <!-- 登录表单 -->
                    <Grid Visibility="{Binding IsLoginMode,Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Height="50" Margin="0,0,0,14">
                            <RadioButton
                                GroupName="LoginType"
                                Content="用户名登录"
                                Style="{StaticResource AuthOption}"
                                IsChecked="{Binding LoginType, Converter={StaticResource StringEquals}, ConverterParameter=Username}"/>
                            <TextBlock Style="{StaticResource AuthOptionSeparator}"/>
                            <RadioButton
                                GroupName="LoginType"
                                Content="手机号登录"
                                Style="{StaticResource AuthOption}"
                                IsChecked="{Binding LoginType, Converter={StaticResource StringEquals}, ConverterParameter=PhoneNumber}"/>
                            <TextBlock Style="{StaticResource AuthOptionSeparator}"/>
                            <RadioButton
                                GroupName="LoginType"
                                Content="邮箱登录"
                                Style="{StaticResource AuthOption}"
                                IsChecked="{Binding LoginType, Converter={StaticResource StringEquals}, ConverterParameter=Email}"/>
                        </StackPanel>
                        <TextBox
                            Grid.Row="1"
                            Text="{Binding Identifier,UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource FloatingField}"
                            controls:FloatingLabel.Text="{Binding IdentifierLabel}"
                            controls:FieldIcon.Geometry="{Binding LoginType, Converter={StaticResource IconByMode}}"/>
                        <controls:PasswordField
                            Grid.Row="2"
                            Margin="0,18,0,0"
                            Label="密码"
                            controls:FieldIcon.Geometry="{StaticResource IconLock}"
                            PasswordChanged="OnLoginPasswordChanged"/>
                        <Button
                            Grid.Row="3"
                            Content="登 录"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding CanSubmit}"
                            Style="{StaticResource Primary}"
                            Margin="0,30,0,0"/>
                    </Grid>

                    <!-- 注册表单 -->
                    <Grid Visibility="{Binding IsRegisterMode,Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox
                            Text="{Binding RegisterUsername,UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource FloatingField}"
                            controls:FloatingLabel.Text="用户名"
                            controls:FieldIcon.Geometry="{StaticResource IconUser}"/>
                        <controls:PasswordField
                            Grid.Row="1"
                            Margin="0,14,0,0"
                            Label="密码（至少 6 位）"
                            controls:FieldIcon.Geometry="{StaticResource IconLock}"
                            PasswordChanged="OnRegisterPasswordChanged"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Height="50" Margin="0,14,0,0">
                            <RadioButton
                                GroupName="VerifyType"
                                Content="邮箱验证"
                                Style="{StaticResource AuthOption}"
                                IsChecked="{Binding VerifyType, Converter={StaticResource StringEquals}, ConverterParameter=Email}"/>
                            <TextBlock Style="{StaticResource AuthOptionSeparator}"/>
                            <RadioButton
                                GroupName="VerifyType"
                                Content="手机验证"
                                Style="{StaticResource AuthOption}"
                                IsChecked="{Binding VerifyType, Converter={StaticResource StringEquals}, ConverterParameter=PhoneNumber}"/>
                        </StackPanel>
                        <TextBox
                            Grid.Row="3"
                            Text="{Binding VerificationTarget,UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource FloatingField}"
                            controls:FloatingLabel.Text="{Binding VerificationTargetLabel}"
                            controls:FieldIcon.Geometry="{Binding VerifyType, Converter={StaticResource IconByMode}}"
                            Margin="0,14,0,0"/>
                        <Grid Grid.Row="4" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Text="{Binding VerificationCode,UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FloatingField}"
                                controls:FloatingLabel.Text="验证码"
                                controls:FieldIcon.Geometry="{StaticResource IconShield}"/>
                            <Button
                                Grid.Column="1"
                                Content="{Binding SendCodeText}"
                                Command="{Binding SendCodeCommand}"
                                Style="{StaticResource Outline}"
                                Margin="12,0,0,0"/>
                        </Grid>
                        <Button
                            Grid.Row="5"
                            Content="注 册"
                            Command="{Binding RegisterCommand}"
                            IsEnabled="{Binding CanSubmit}"
                            Style="{StaticResource Primary}"
                            Margin="0,24,0,0"/>
                    </Grid>
                    <TextBlock
                        Text="{Binding StatusMessage}"
                        Foreground="{Binding StatusBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Margin="0,16,0,0"
                        MinHeight="22"/>
                    <Button
                        Content="{Binding ModeSwitchText}"
                        Command="{Binding SwitchModeCommand}"
                        Style="{StaticResource Link}"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 已登录页面：侧边导航 + 用户中心 -->
        <Grid Grid.Row="1" Visibility="{Binding IsAuthenticated,Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#E1E3E6" BorderThickness="0,0,1,0">
                <StackPanel Margin="24,46,18,0">
                    <TextBlock Text="⌂   首页" FontSize="16" Padding="5,14"/>
                    <Border Background="#111" Padding="8,14" Margin="0,8,0,0">
                        <TextBlock Text="◉   用户中心" Foreground="White" FontSize="16"/>
                    </Border>
                    <TextBlock Text="◇   任务监控" Foreground="#8C9199" FontSize="16" Padding="5,22"/>
                    <TextBlock Text="⚙   系统设置" Foreground="#8C9199" FontSize="16" Padding="5,14"/>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1" Margin="44,42">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <StackPanel>
                        <TextBlock Text="用户中心" FontSize="44" FontWeight="Light"/>
                        <TextBlock Text="账户信息 · 会话管理" Foreground="#888D96" FontSize="16" Margin="3,8,0,0"/>
                    </StackPanel>
                    <Button
                        Content="退出登录"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource Outline}"
                        Width="130"
                        Height="42"
                        DockPanel.Dock="Right"
                        Margin="0,10,0,0"/>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,56,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border BorderBrush="#1B1B1B" BorderThickness="1" Padding="32">
                        <StackPanel>
                            <TextBlock Text="账户档案" FontSize="22"/>
                            <Border
                                Width="82"
                                Height="82"
                                Background="#111"
                                CornerRadius="41"
                                HorizontalAlignment="Left"
                                Margin="0,30,0,22">
                                <Grid ClipToBounds="True">
                                    <TextBlock Text="{Binding UserInitial}" Foreground="White" FontSize="32"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <Image Source="{Binding AvatarPreview}" Stretch="UniformToFill"/>
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="选择图片" Command="{Binding SelectAvatarCommand}" Style="{StaticResource Outline}"/>
                                <Button Content="保存头像" Command="{Binding UploadAvatarCommand}" IsEnabled="{Binding CanUploadAvatar}"
                                        Style="{StaticResource Outline}" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="JPG、JPEG、PNG，最大 2 MB" Foreground="#858A92" Margin="0,0,0,18"/>
                            <TextBlock Text="{Binding CurrentUser.Username}" FontSize="25"/>
                            <TextBlock Text="已安全登录 CKKS System" Foreground="#868B94" Margin="0,8,0,28"/>
                            <Separator/>
                            <TextBlock Text="用户 ID" Foreground="#858A92" Margin="0,24,0,5"/>
                            <TextBlock Text="{Binding CurrentUser.UserId}" FontSize="17"/>
                            <TextBlock Text="邮箱" Foreground="#858A92" Margin="0,20,0,5"/>
                            <TextBlock Text="{Binding CurrentUser.Email}" FontSize="17"/>
                            <TextBlock Text="手机号" Foreground="#858A92" Margin="0,20,0,5"/>
                            <TextBlock Text="{Binding CurrentUser.PhoneNumber}" FontSize="17"/>
                        </StackPanel>
                    </Border>

                    <!-- 会话状态 -->
                    <StackPanel Grid.Column="1" Margin="52,0,0,0">
                        <TextBlock Text="会话状态" FontSize="22"/>
                        <TextBlock Text="本次会话令牌仅保存在内存中，关闭程序后将自动失效。" Foreground="#858A92" Margin="0,14,0,0"/>
                        <Border Background="#F3F3F1" Padding="24" Margin="0,32,0,0">
                            <StackPanel>
                                <TextBlock Text="安全提示" FontSize="17"/>
                                <TextBlock Text="请勿在公共设备上长期保持登录状态。" Foreground="#686D75" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
