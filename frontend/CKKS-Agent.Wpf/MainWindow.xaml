<Window x:Class="CKKS_Agent.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="个人头像 · CKKS Agent" Height="620" Width="760"
        WindowStartupLocation="CenterScreen" Background="#F4F7FB">
  <Grid Margin="32">
    <Border Background="White" CornerRadius="20" Padding="48" BorderBrush="#E3E8F2" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
          <TextBlock Text="账户设置" Foreground="#536176" FontWeight="Bold" FontSize="13" />
          <TextBlock Text="个人头像" FontSize="30" FontWeight="SemiBold" Margin="0,7,0,4" />
          <TextBlock Text="上传一张清晰的照片，让团队成员更容易认出你。" Foreground="{StaticResource MutedBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,36,0,24">
          <Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Width="112" Height="112" CornerRadius="56" Background="#DCE9FF" ClipToBounds="True" HorizontalAlignment="Left">
            <Grid>
              <Image Source="{Binding AvatarPreview}" Stretch="UniformToFill" />
              <TextBlock Text="U" FontSize="38" FontWeight="Bold" Foreground="#1D5FD2" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Visibility="{Binding AvatarPlaceholderVisibility}" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Button Content="选择图片" Command="{Binding SelectFileCommand}" Background="{StaticResource AccentBrush}" Foreground="White" />
              <Button Content="撤销选择" Command="{Binding ResetCommand}" Margin="9,0,0,0" Background="#EEF2F7" Foreground="#43516A" />
            </StackPanel>
            <TextBlock Text="支持 JPG、PNG、WebP，最大 2 MB。保存前不会上传。" Margin="0,11,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#B8C8E5" BorderThickness="1" CornerRadius="12" Background="#F9FBFF" Padding="24" AllowDrop="True"
                DragEnter="UploadDropZone_DragEnter" DragLeave="UploadDropZone_DragLeave" Drop="UploadDropZone_Drop" MouseLeftButtonUp="UploadDropZone_MouseLeftButtonUp">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="↑" HorizontalAlignment="Center" FontSize="26" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="将图片拖到这里，或点击此处选择文件" Margin="0,7,0,0" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="客户端会先检查格式、文件头和文件大小" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="3" Margin="0,24,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,20,0" />
          <Button Grid.Column="1" Content="保存头像" Command="{Binding UploadCommand}" IsEnabled="{Binding CanUpload}" Background="{StaticResource AccentBrush}" Foreground="White" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
